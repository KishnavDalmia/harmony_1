
AWS_ACCESS_KEY_ID=your_aws_access_key
AWS_SECRET_ACCESS_KEY=your_aws_secret_key
AWS_REGION=us-east-1
AWS_S3_BUCKET=harmony-frames

USE_AWS_REKOGNITION=
USE_AWS_DYNAMODB=

# --- Mistral (optional) - reranks recommendations with an LLM ---
# When MISTRAL_API_KEY is set, the recommender asks Mistral to reorder the
# locally scored tracks for the detected mood. If unset or unreachable, local
# ranking is used unchanged.
MISTRAL_API_KEY=your_mistral_api_key
MISTRAL_MODEL=mistral-small-latest

SPOTIFY_CLIENT_ID=your_spotify_client_id
SPOTIFY_CLIENT_SECRET=your_spotify_client_secret
SPOTIFY_REDIRECT_URI=http://127.0.0.1:8000/callback

FRONTEND_REDIRECT_URI=http://localhost:3000

APP_ENV=development
DEBUG=true